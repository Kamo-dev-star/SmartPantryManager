<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1114">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#7CFF6B"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your Smart Pantry preferences"
            android:textSize="15sp"
            android:textColor="#B8C2C7"
            android:paddingBottom="20dp" />

        <!-- Preferences Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/recipe_card_background"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Preferences"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingBottom="8dp" />

            <android.widget.Switch
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiring-soon alerts"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtSettingsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable alerts to help keep track of pantry items approaching their expiry date."
                android:textSize="15sp"
                android:textColor="#B8C2C7"
                android:lineSpacingExtra="4dp"
                android:paddingTop="4dp" />

        </LinearLayout>

        <!-- App Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/recipe_card_background"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 About Smart Pantry"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager helps you organise ingredients, monitor expiry dates and discover recipes using items available in your pantry."
                android:textSize="15sp"
                android:textColor="#B8C2C7"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="14sp"
                android:textColor="#7CFF6B"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>