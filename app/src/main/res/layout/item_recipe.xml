<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/recipe_card_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txtRecipeIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="🍽️"
        android:textSize="30sp"
        android:background="#263238" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/txtRecipeItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tomato Pasta"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRecipeItemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A simple meal using ingredients from your pantry."
            android:textColor="#B8C2C7"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:maxLines="2" />

    </LinearLayout>

</LinearLayout>